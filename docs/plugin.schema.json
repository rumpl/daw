{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://daw.local/schemas/plugin-v1.json",
  "title": "docker-agent dashboard plugin",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "id", "name"],
  "properties": {
    "apiVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$" },
    "name": { "type": "string", "minLength": 1, "maxLength": 80 },
    "description": { "type": "string", "maxLength": 300 },
    "version": { "type": "string", "maxLength": 40 },
    "entry": { "type": "string", "pattern": "^[^.].*\\.(m?js)$" },
    "style": { "type": "string", "pattern": "^[^.].*\\.css$" },
    "backend": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entry"],
      "properties": {
        "entry": { "type": "string", "pattern": "^[^.].+/(?:[^/]+)\\.(?:mjs|cjs|js)$" },
        "webhooks": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$" }
            }
          }
        },
        "mcp": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$" },
              "command": { "type": "string", "minLength": 1 },
              "args": { "type": "array", "items": { "type": "string" } },
              "env": { "type": "object", "additionalProperties": { "type": "string" } },
              "workingDir": { "type": "string" },
              "url": { "type": "string", "format": "uri" },
              "transport": { "enum": ["sse", "streamable", "streamable-http"] },
              "headers": { "type": "object", "additionalProperties": { "type": "string" } }
            },
            "oneOf": [
              { "required": ["command"], "not": { "required": ["url"] } },
              { "required": ["url"], "not": { "required": ["command"] } }
            ]
          }
        }
      }
    },
    "configuration": {
      "type": "object",
      "description": "JSON Schema used by the plugin for its public configuration"
    },
    "pages": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "path", "label", "sidebar"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$" },
          "path": { "type": "string", "pattern": "^$|^[a-z0-9][a-z0-9/-]*$" },
          "label": { "type": "string", "minLength": 1, "maxLength": 60 },
          "sidebar": { "type": "boolean" }
        }
      }
    }
  }
}
