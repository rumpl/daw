{
  "name": "daw-desktop",
  "version": "1.0.0",
  "description": "Electron desktop host for Atelier, the programmable coding studio",
  "author": "Atelier contributors",
  "private": true,
  "main": "main.cjs",
  "scripts": {
    "electron:install": "ELECTRON_SKIP_BINARY_DOWNLOAD= node node_modules/electron/install.js",
    "start": "npm run electron:install && electron .",
    "dist": "npm run electron:install && electron-builder"
  },
  "devDependencies": {
    "electron": "41.10.5",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.docker.daw",
    "productName": "Atelier",
    "asar": true,
    "files": [
      "main.cjs",
      "preload.cjs",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../bin/dawui",
        "to": "backend/dawui"
      },
      {
        "from": "../bin/daw-sandbox",
        "to": "backend/daw-sandbox"
      },
      {
        "from": "../bin/daw-runner-kit.ref",
        "to": "backend/daw-runner-kit.ref"
      },
      {
        "from": "build/icon.png",
        "to": "icon.png"
      },
      {
        "from": "build/trayTemplate.png",
        "to": "trayTemplate.png"
      },
      {
        "from": "build/trayTemplate@2x.png",
        "to": "trayTemplate@2x.png"
      }
    ],
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.developer-tools",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Atelier uses your microphone to transcribe speech into chat messages."
      },
      "binaries": [
        "Contents/Resources/backend/dawui",
        "Contents/Resources/backend/daw-sandbox"
      ],
      "target": [
        "dmg",
        "zip"
      ]
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Development",
      "target": [
        "AppImage"
      ]
    }
  },
  "dependencies": {
    "ws": "8.18.3"
  }
}
